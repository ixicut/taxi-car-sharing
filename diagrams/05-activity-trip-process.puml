@startuml 05-activity-trip-process
!include _style.puml
skinparam linetype polyline

title RideHub — Діаграма діяльності: поїздка таксі від замовлення до оцінки

|#FFFFFF|Пасажир|
|#DDEBF7|RideHub|
|#FFFFFF|Водій|
|#FFF2CC|Платіжний провайдер|

|Пасажир|
start
:Вказати «звідки», «куди» і клас авто;

|RideHub|
:Побудувати маршрут і ETA\n(картографічний сервіс);
:Розрахувати ціну за тарифом і surge;

|Пасажир|
if (Ціна влаштовує?) then (так)
  :Обрати спосіб оплати і замовити;
else (ні)
  stop
endif

|RideHub|
:Створити поїздку **CREATED**;

if (Оплата карткою?) then (так)
  |Платіжний провайдер|
  :Заблокувати суму (hold);
  if (Hold відхилено?) then (так)
    |Пасажир|
    :Отримати відмову,\nзмінити спосіб оплати пізніше;
    stop
  else (ні / PSP недоступний)
  endif
else (готівка)
endif

|RideHub|
:Почати пошук водія **SEARCHING**;

while (Водія призначено?) is (ні)
  if (Минуло 3 хв?) then (так)
    |Пасажир|
    if (Прийняти альтернативу?) then (ні)
      |RideHub|
      :Скасувати поїздку **CANCELLED**\n(NO_DRIVER_FOUND), зняти hold;
      stop
    else (підвищити клас / чекати)
    endif
  endif
  |RideHub|
  :Надіслати пропозицію\nнаступному кандидату;
  |Водій|
  :Прийняти або відхилити (15 с);
  |RideHub|
endwhile (так)

:Зафіксувати водія **DRIVER_ASSIGNED**;

fork
  |Водій|
  :Їхати до точки подачі за навігацією;
fork again
  |RideHub|
  :Транслювати позицію водія\nна мапу пасажира (кожні 3 с);
fork again
  |RideHub|
  :Надіслати пасажиру push\n«Водія призначено»;
end fork

|Водій|
:Наблизитись на 200 м **DRIVER_ARRIVING**;
:Позначити «На місці» **DRIVER_ARRIVED**;

|Пасажир|
:Сісти в авто;

|Водій|
:Почати поїздку **IN_PROGRESS**;
:Довезти пасажира і завершити поїздку;

|RideHub|
:Розрахувати фінальну суму **COMPLETED**;

if (Оплата карткою?) then (так)
  |Платіжний провайдер|
  :Списати фінальну суму (capture),\nрізницю з hold розблокувати;
  note right
    Якщо списання не вдалося:
    PAYMENT_FAILED → PAYMENT_RETRY → PAID | DEBT
    (див. діаграму станів 5.3)
  end note
else (готівка)
  |Водій|
  :Отримати готівку від пасажира;
  |RideHub|
  :Списати комісію з балансу водія;
endif

|RideHub|
:Позначити поїздку **PAID**;

fork
  |RideHub|
  :Сформувати фіскальний чек (ПРРО);
fork again
  |RideHub|
  :Оновити баланси водія і партнера;
fork again
  |Пасажир|
  :Оцінити водія (1–5);
fork again
  |Водій|
  :Повернутися на лінію;
end fork

|RideHub|
stop

@enduml
