@startuml 09-dfd-driver-auth
!include _style.puml
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 70

title DFD 1 — Автентифікація водія (Driver App ↔ Gateway ↔ Identity ↔ KYC)

package "TB-1: Пристрій водія (недовірений)" #FDF2F0 {
  actor "EE-1 Водій\n+ Driver App" as EE1
}

package "TB-2: Периметр (DMZ)" #FFF2CC {
  rectangle "P-1.1\nAPI Gateway (Kong)\nперевірка JWT, rate limit" as P11
}

package "TB-3: Внутрішня мережа RideHub" #E2EFDA {
  rectangle "P-1.2\nIdentity Service\n(Keycloak)\nOTP, device binding, liveness" as P12
  database "DS-1.1\nIdentity DB\nкористувачі, публічні ключі\nпристроїв, документи" as DS11
  database "DS-1.2\nAudit Log\n(append-only)" as DS12
}

package "TB-4: Зовнішні системи" #EDEDED {
  rectangle "EE-2\nKYC «Дія»" as EE2
  rectangle "EE-3\nSMS-шлюз" as EE3
}

EE1 --> P11 : DF-1.1 phone, OTP,\nпідписаний challenge пристрою (HTTPS)
EE1 --> P11 : DF-1.2 селфі (liveness)\n(HTTPS)
P11 --> P12 : DF-1.3 запит токена (OIDC)
P12 --> P11 : DF-1.4 JWT access + refresh
P11 --> EE1 : DF-1.5 JWT
P12 --> EE3 : DF-1.6 відправка OTP
EE3 ..> EE1 : DF-1.7 SMS з OTP
P12 <--> DS11 : DF-1.8 читання / запис
P12 <--> EE2 : DF-1.9 перевірка документів\n(зі згоди водія)
P12 --> DS12 : DF-1.10 події входу,\nзміни пристрою

note bottom of P12
  Межі довіри:
  TB-1 → TB-2: усі дані недовірені
  TB-2 → TB-3: тільки перевірені запити
  TB-3 → TB-4: дані, що повертаються, перевіряються
end note

@enduml
